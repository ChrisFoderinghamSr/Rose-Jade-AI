{
  "name": "rose-jade-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Rose Jade AI — an independently engineered conversational AI platform.",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@rose-jade/web",
    "start": "npm run start --workspace=@rose-jade/web",
    "build": "npm run build --workspace=@rose-jade/web",
    "typecheck": "npm run typecheck --workspace=@rose-jade/web",
    "test": "node --test tests/*.test.mjs",
    "test:package": "node tests/packaged-server.mjs",
    "format": "prettier --write apps/web packages/*/src tests scripts",
    "format:check": "prettier --check apps/web packages/*/src tests scripts",
    "db:migrate": "node scripts/cloud-migrate.mjs",
    "check:cloud": "node scripts/check-cloud.mjs"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "latest",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "dependencies": {
    "next": "15.5.29"
  }
}
