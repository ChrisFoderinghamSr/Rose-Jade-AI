# Cloud-only runtime. Add these non-secret settings to the host.
APP_ORIGIN=https://RoseJade.chrisfoderingham.com
COOKIE_SECURE=true
AWS_REGION=us-east-2
RDS_CLUSTER_ARN=
RDS_SECRET_ARN=
RDS_DATABASE=rosejade
APP_CONFIG_SECRET_ARN=
# Public access is closed unless an explicit future timestamp is configured.
PUBLIC_ACCESS_UNTIL=
EMBED_ORIGINS=

# Preferred: put the following secret values in APP_CONFIG_SECRET_ARN JSON.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OWNER_EMAIL=
# OWNER_PASSWORD=
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_PLAN_STARTER=
# PAYPAL_PLAN_PLUS=
# PAYPAL_PLAN_PRO=
# MAIL_MODE=capture
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# SMTP_ALLOWED_RECIPIENTS=
