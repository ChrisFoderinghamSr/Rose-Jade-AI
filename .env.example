# Put real values in apps/web/.env.local, never in Git.
APP_ORIGIN=http://127.0.0.1:3120
# For hosted deployment use https://RoseJade.chrisfoderingham.com
COOKIE_SECURE=false
ROSE_PUBLIC_DEPLOYMENT=false
# ROSE_DATA_DIR=/persistent/private/rose-jade
# OWNER_EMAIL=your-owner-email
# OWNER_PASSWORD=unique-14-plus-character-bootstrap-password
# Temporary public access defaults to 7 days from first database initialization.
# PUBLIC_ACCESS_UNTIL=2026-11-16T23:59:59Z

# Local models: install/select a separately licensed model yourself.
OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=your-installed-model
# Cloud AI requires an API key, model access, billing and in-app consent.
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Portfolio iframe ancestors; leave blank for same-origin only.
# EMBED_ORIGINS=https://your-portfolio.example

MAIL_MODE=capture
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# SMTP_ALLOWED_RECIPIENTS=approved-recipient@example.org

# PayPal defaults to sandbox. Set live only after sandbox validation.
PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=
# PAYPAL_PLAN_STARTER=
# PAYPAL_PLAN_PLUS=
# PAYPAL_PLAN_PRO=
